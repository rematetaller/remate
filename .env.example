# =====================================================
# .env.example — NOMBRES de las variables. Nunca valores.
#
# remateTaller no tiene .env: no hay nada que lo lea. Este archivo es la
# LISTA de lo que hay que cargar en Vercel → Project → Settings →
# Environment Variables, y lo carga Mauro a mano, en la web.
#
# Ningún chat pide el valor de una credencial ni lo carga por API: su
# entregable es el nombre exacto de la variable y dónde pegarla. Ver
# LUCES.md y PROTOCOLO-SECRETOS.md del repo privado `datos`.
#
# El .gitignore bloquea cualquier .env real. El historial de git es
# permanente: borrarlo después no alcanza.
# =====================================================

# Access ID de la app creada en Tuya IoT Platform (Cloud → Development).
TUYA_CLIENT_ID=

# Access Secret de esa misma app. Es el secreto con el que se firma cada
# pedido. Sólo en Vercel.
TUYA_CLIENT_SECRET=

# Centro de datos donde está la cuenta de Tuya: us | eu | cn | in
# Para Uruguay normalmente es `us` (Western America). Por defecto: us
TUYA_REGION=

# Las luces del depósito, como JSON en una sola línea. El panel manda el
# ALIAS; el identificador real del dispositivo no sale del servidor.
#
#   forma corta:  {"deposito":"IDENTIFICADOR"}          → comando switch_1
#   forma larga:  {"deposito":{"id":"IDENTIFICADOR",
#                              "label":"Depósito",
#                              "comando":"switch_1"}}
#
# El `label` es lo que ve la gente en el panel. Poner varias si el depósito
# tiene la luz partida en zonas: {"frente":..., "fondo":...}
TUYA_LUCES=

# Desde qué direcciones se acepta un pedido, separadas por coma. El panel
# vive en GitHub Pages y la función en Vercel: son dos orígenes distintos,
# y sin esta lista el navegador ni siquiera manda el pedido.
# Por defecto: https://rematetaller.github.io
# Si algún día el sitio pasa a dominio propio (§12.2), esta lista cambia
# EN LA MISMA TANDA o las luces dejan de responder.
ORIGENES_PERMITIDOS=
